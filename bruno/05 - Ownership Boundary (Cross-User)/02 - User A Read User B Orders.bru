meta {
  name: User A Read User B Orders
  type: http
  seq: 2
}

get {
  url: {{supabase_url}}/rest/v1/orders?select=*&user_id=eq.{{user_id_b}}
  body: none
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{access_token_a}}
}

tests {
  test("status is 200, but zero rows returned", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([]);
  });
}

docs {
  Same idea as the addresses check, applied to order history - this
  is the boundary that keeps one customer from browsing another
  customer's purchase history by guessing/iterating user ids.
}
