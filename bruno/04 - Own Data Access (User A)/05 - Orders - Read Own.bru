meta {
  name: Orders - Read Own
  type: http
  seq: 5
}

get {
  url: {{supabase_url}}/rest/v1/orders?select=*
  body: none
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{access_token_a}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("every row belongs to me", function() {
    const rows = res.getBody();
    const myId = bru.getEnvVar("user_id_a");
    rows.forEach((r) => expect(r.user_id).to.equal(myId));
  });
}

docs {
  orders_select_own. Should return only orders created by this test
  user - never any of the 14 real orders belonging to other accounts.
}
