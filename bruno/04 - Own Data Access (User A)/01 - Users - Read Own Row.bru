meta {
  name: Users - Read Own Row
  type: http
  seq: 1
}

get {
  url: {{supabase_url}}/rest/v1/users?select=*
  body: none
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{access_token_a}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("sees exactly 1 row - itself", function() {
    const rows = res.getBody();
    expect(rows.length).to.equal(1);
    expect(rows[0].id).to.equal(bru.getEnvVar("user_id_a"));
  });
}

docs {
  Note there's no ?id=eq... filter in the URL at all - this is a
  request for "every row in users". users_select_own still narrows it
  down to exactly one row (the caller's own), which is the RLS policy
  doing its job rather than the query doing it.
}
