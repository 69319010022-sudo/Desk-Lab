meta {
  name: Sign In Test User A
  type: http
  seq: 1
}

post {
  url: {{supabase_url}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{test_email_a}}",
    "password": "{{test_password_a}}"
  }
}

script:post-response {
  const data = res.getBody();
  bru.setEnvVar("access_token_a", data.access_token);
  bru.setEnvVar("user_id_a", data.user.id);
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("received an access token", function() {
    expect(res.getBody()).to.have.property("access_token");
  });
}

docs {
  Run this before any request in folders 04-06 - it captures
  access_token_a and user_id_a into the environment for reuse.
}
